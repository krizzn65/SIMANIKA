# The Laravel app lives inside the web root on the hosting account. Its code,
# logs, configuration and uploads must never be served directly; the site
# reaches it only through the root index.php.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
