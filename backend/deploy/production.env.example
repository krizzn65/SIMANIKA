# Salin nilai ini ke backend/.env di hosting, lalu isi semua rahasia di sana.
# Jangan unggah file .env atau template ini ke web root publik.
APP_NAME=SIMANIKA
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://himanika.wsmif.myhost.id
FRONTEND_URL=https://himanika.wsmif.myhost.id

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_DOMAIN=himanika.wsmif.myhost.id
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=himanika.wsmif.myhost.id
CORS_ALLOWED_ORIGINS=https://himanika.wsmif.myhost.id
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

ADMIN_EMAIL=himanikamif@gmail.com
# Alternatif: gunakan SMTP provider hosting, atau MAIL_MAILER=sendmail
# dengan MAIL_SENDMAIL_PATH sesuai petunjuk provider. MAIL_FROM_ADDRESS
# harus alamat yang diizinkan provider; ADMIN_EMAIL boleh tetap Gmail.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=himanikamif@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=himanikamif@gmail.com
MAIL_FROM_NAME=SIMANIKA
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://himanika.wsmif.myhost.id/api/auth/google/callback
